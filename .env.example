# Copy to .env for Docker or a manually managed database. Never commit .env.
# Windows: scripts/start-database.ps1 generates a ready-to-use .env instead.
DATABASE_URL=postgresql://luxe:CHANGE_ME@127.0.0.1:5433/luxe_woman?schema=public

# Same-origin browser requests pass through the Next.js /api/v1 proxy.
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000
API_PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Seed is explicitly fictional. Set a unique development password before seeding.
SEED_ADMIN_EMAIL=admin@luxewoman.local
SEED_ADMIN_PASSWORD=
DEMO_MODE=true

# API paths are relative to apps/api when launched with npm workspaces.
PRIVATE_STORAGE_PATH=../../.local/uploads
SESSION_DAYS=30

# Configure to enable Google OAuth. Callback: API_URL/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Without SMTP, development messages remain private files in storage.
# Production must use a real SMTP provider and HTTPS APP_URL/API_URL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LUXE WOMAN <no-reply@example.com>

# Docker Compose local database. Choose a separate random value.
POSTGRES_PASSWORD=
