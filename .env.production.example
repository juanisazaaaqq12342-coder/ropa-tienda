# ==============================================================================
# LUXE WOMAN — Plantilla de Variables de Entorno para Producción
# ==============================================================================
# Copia estos valores en la sección "Environment Variables" de tu hosting
# (Render / Railway / VPS para el Backend API, y Vercel para el Frontend).
# NUNCA subas archivos .env con credenciales reales a tu repositorio público.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (Neon / Supabase / Railway / PostgreSQL VPS)
# ------------------------------------------------------------------------------
# Obtén tu connection string en https://neon.tech o https://supabase.com
# Ejemplo Neon: postgresql://usuario:contraseña@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST_DE_NEON_O_SUPABASE/NOMBRE_DB?sslmode=require

# ------------------------------------------------------------------------------
# 2. SERVIDOR Y DOMINIOS PÚBLICOS (Con SSL HTTPS obligatorio en producción)
# ------------------------------------------------------------------------------
NODE_ENV=production
API_PORT=4000
APP_URL=https://luxewoman.com.co
API_URL=https://api.luxewoman.com.co
NEXT_PUBLIC_APP_URL=https://luxewoman.com.co
NEXT_PUBLIC_API_URL=https://api.luxewoman.com.co/api/v1

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y SESIONES
# ------------------------------------------------------------------------------
# Genera cadenas aleatorias de 64 caracteres para producción
SESSION_DAYS=30
PRIVATE_STORAGE_PATH=/var/data/uploads

# ------------------------------------------------------------------------------
# 4. SERVICIO DE CORREO TRANSACCIONAL (Resend o Brevo)
# ------------------------------------------------------------------------------
# Opción A (Recomendada): Resend API (HTTPS instantáneo)
# Regístrate en https://resend.com y genera tu llave
RESEND_API_KEY=re_123456789abcdefghijklmnopqrstuvwxyz
SMTP_FROM=LUXE WOMAN <pedidos@luxewoman.com.co>

# Opción B (Alternativa): Brevo o SMTP tradicional
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=tu-usuario-brevo
# SMTP_PASS=tu-clave-smtp-brevo

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH (Opcional - solo si deseas login con Google)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
