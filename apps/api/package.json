    "@types/cookie-parser": "^1.4.9", "@types/express": "^5.0.3", "@types/multer": "^2.0.0", "@types/node": "^24.0.0", "@types/nodemailer": "^7.0.0", "@types/pg": "^8.15.5", "prisma": "^7.0.0", "typescript": "^5.9.0"
